{
  "name": "bloxcode",
  "version": "1.3.0",
  "description": "External code editor for Roblox Studio",
  "main": "app/main.js",
  "author": "Veitheim",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "node tools/make-icon.js",
    "dist": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac --universal",
    "docs:build": "cd studio-plugin && npx moonwave build --code src && cd .. && node tools/fix-docs-links.js",
    "docs:deploy": "cd studio-plugin && npx wrangler deploy",
    "release": "node tools/release.js",
    "release:mac": "node tools/release.js --mac"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3",
    "monaco-editor": "0.52.2"
  },
  "build": {
    "appId": "dev.schroll.bloxcode",
    "productName": "Bloxcode",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "package.json",
      "!node_modules/monaco-editor/esm/**",
      "!node_modules/monaco-editor/dev/**",
      "!node_modules/monaco-editor/min-maps/**"
    ],
    "extraResources": [
      {
        "from": "studio-plugin/src/CodeBridge.lua",
        "to": "studio-plugin/CodeBridge.lua"
      },
      {
        "from": "app/mcp/bloxcode-mcp.js",
        "to": "mcp/bloxcode-mcp.js"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bloxcode",
      "runAfterFinish": true,
      "artifactName": "Bloxcode-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Bloxcode-${version}-mac.${ext}"
    },
    "dmg": {
      "title": "Bloxcode ${version}",
      "artifactName": "Bloxcode-${version}-mac.${ext}"
    },
    "publish": {
      "provider": "generic",
      "url": "https://bloxcode-docs.seidl.workers.dev/updates"
    }
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
